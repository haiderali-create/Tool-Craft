{
  "name": "toolcraft-store",
  "main": "./worker.ts",
  "compatibility_date": "2025-03-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
